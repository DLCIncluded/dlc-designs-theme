{
    "name": "dlcincluded/dlc-designs-theme",
    "type": "wordpress-theme",
    "description": "A dark, terminal-inspired WooCommerce theme for the DLC Designs shop.",
    "keywords": [
        "WordPress",
        "Themes",
        "WooCommerce"
    ],
    "homepage": "https://github.com/DLCIncluded/dlc-designs-theme",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "DLC Designs",
            "homepage": "https://github.com/DLCIncluded/dlc-designs-theme/graphs/contributors"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.0",
        "wptrt/wpthemereview": "^0.2.1",
        "php-parallel-lint/php-parallel-lint": "^1.2.0",
        "wp-cli/i18n-command": "^2.2.5"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "audit": {
            "ignore": [
                "PKSA-mh9b-91zm-m1gy"
            ]
        }
    },
    "scripts": {
        "lint:wpcs": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs",
        "lint:php": "@php ./vendor/bin/parallel-lint --exclude .git --exclude vendor .",
        "make-pot": "wp i18n make-pot . languages/dlc-designs.pot"
    },
    "support": {
        "issues": "https://github.com/DLCIncluded/dlc-designs-theme/issues",
        "source": "https://github.com/DLCIncluded/dlc-designs-theme"
    }
}
